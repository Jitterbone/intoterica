<div class="quests-container">
  <div class="section-header quest-page-header">
    <div class="section-title"><i class="fas fa-scroll"></i> Quest Journal</div>
    <div class="quest-header-actions">
      <!-- Search Bar -->
      <div class="quest-search-bar">
        <i class="fas fa-search quest-search-icon"></i>
        <input type="text" class="quest-search-input" placeholder="Search quests by name..." value="{{questSearch}}" autocomplete="off" spellcheck="false">
        {{#if questSearch}}
          <button type="button" class="clear-quest-search" title="Clear Search"><i class="fas fa-times"></i></button>
        {{/if}}
      </div>

      <!-- Advanced Filters & Sort Toggle Button -->
      <button type="button" class="quest-filter-toggle-btn {{#if hasActiveFilters}}active-filters{{/if}}" title="Toggle Filter & Sort Controls">
        <i class="fas fa-sliders-h"></i> Filters & Sort
        {{#if activeFilterCount}}
          <span class="active-filter-badge">{{activeFilterCount}}</span>
        {{/if}}
      </button>

      {{#if perms.quests}}
        <button type="button" class="add-quest"><i class="fas fa-plus"></i> New Quest</button>
      {{/if}}
    </div>
  </div>

  <!-- Collapsible Advanced Filter & Sort Toolbar -->
  <div class="quest-advanced-filter-toolbar {{#if showAdvancedFilters}}show{{/if}}">
    <div class="filter-group">
      <label><i class="fas fa-shield-alt"></i> Faction:</label>
      <select class="quest-filter-faction">
        <option value="">All Factions</option>
        {{#each questFilterFactions}}
          <option value="{{this}}" {{#if (eq ../questFactionFilter this)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label><i class="fas fa-user-circle"></i> Giver / NPC:</label>
      <select class="quest-filter-giver">
        <option value="">All Givers</option>
        {{#each questFilterGivers}}
          <option value="{{this}}" {{#if (eq ../questGiverFilter this)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label><i class="fas fa-signal"></i> Difficulty:</label>
      <select class="quest-filter-difficulty">
        <option value="">All Difficulties</option>
        {{#each questFilterDifficulties}}
          <option value="{{this.id}}" {{#if (eq ../questDifficultyFilter this.id)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-group">
      <label><i class="fas fa-sort-amount-down"></i> Sort:</label>
      <select class="quest-filter-sort">
        <option value="default" {{#if (eq questSort 'default')}}selected{{/if}}>Default (Primary & Status)</option>
        <option value="title-asc" {{#if (eq questSort 'title-asc')}}selected{{/if}}>Title (A → Z)</option>
        <option value="title-desc" {{#if (eq questSort 'title-desc')}}selected{{/if}}>Title (Z → A)</option>
        <option value="diff-asc" {{#if (eq questSort 'diff-asc')}}selected{{/if}}>Difficulty (Lowest → Highest)</option>
        <option value="diff-desc" {{#if (eq questSort 'diff-desc')}}selected{{/if}}>Difficulty (Highest → Lowest)</option>
        <option value="reward-desc" {{#if (eq questSort 'reward-desc')}}selected{{/if}}>Reward Value (Highest → Lowest)</option>
        <option value="reward-asc" {{#if (eq questSort 'reward-asc')}}selected{{/if}}>Reward Value (Lowest → Highest)</option>
        <option value="progress-desc" {{#if (eq questSort 'progress-desc')}}selected{{/if}}>Progress (Most Complete)</option>
        <option value="progress-asc" {{#if (eq questSort 'progress-asc')}}selected{{/if}}>Progress (Least Complete)</option>
      </select>
    </div>

    {{#if hasActiveFilters}}
      <button type="button" class="reset-quest-filters" title="Reset all active filters and sorting">
        <i class="fas fa-undo"></i> Reset Filters
      </button>
    {{/if}}
  </div>

  <!-- Quest Filter Tabs -->
  <div class="quest-filter-bar">
    <button type="button" class="quest-filter-btn {{#if (eq questFilter 'active')}}active{{/if}}" data-filter="active">
      <i class="fas fa-compass"></i> Active <span class="filter-count">({{questStats.active}})</span>
    </button>
    <button type="button" class="quest-filter-btn {{#if (eq questFilter 'available')}}active{{/if}}" data-filter="available">
      <i class="fas fa-map-marker-alt"></i> Available <span class="filter-count">({{questStats.available}})</span>
    </button>
    <button type="button" class="quest-filter-btn {{#if (eq questFilter 'completed')}}active{{/if}}" data-filter="completed">
      <i class="fas fa-check-circle"></i> Completed <span class="filter-count">({{questStats.completed}})</span>
    </button>
    <button type="button" class="quest-filter-btn {{#if (eq questFilter 'failed')}}active{{/if}}" data-filter="failed">
      <i class="fas fa-times-circle"></i> Failed <span class="filter-count">({{questStats.failed}})</span>
    </button>
  </div>

  <!-- Quest List -->
  <div class="quest-list">
    {{#each quests}}
      <div class="quest-card {{#if isPrimary}}primary-quest{{/if}} status-{{lowercase status}}" data-quest-id="{{id}}">
        <!-- Quest Banner / Header -->
        <div class="quest-card-header quest-header-clickable" data-quest-id="{{id}}">
          <div class="quest-card-icon-container">
            {{#if image}}
              <img class="quest-card-thumb" src="{{image}}" alt="" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
              <div class="quest-card-fallback-icon" style="display: none;">
                {{#if (eq (lowercase status) 'completed')}}<i class="fas fa-trophy"></i>
                {{else if (eq (lowercase status) 'failed')}}<i class="fas fa-skull-crossbones"></i>
                {{else if isPrimary}}<i class="fas fa-star"></i>
                {{else}}<i class="fas fa-scroll"></i>{{/if}}
              </div>
            {{else}}
              <div class="quest-card-fallback-icon">
                {{#if (eq (lowercase status) 'completed')}}<i class="fas fa-trophy"></i>
                {{else if (eq (lowercase status) 'failed')}}<i class="fas fa-skull-crossbones"></i>
                {{else if isPrimary}}<i class="fas fa-star"></i>
                {{else}}<i class="fas fa-scroll"></i>{{/if}}
              </div>
            {{/if}}
          </div>

          <div class="quest-card-main-info">
            <div class="quest-title-row">
              <div class="quest-title">
                {{#if isPrimary}}<i class="fas fa-star primary-star" title="Primary Objective"></i>{{/if}}
                <span class="quest-title-text">{{title}}</span>
              </div>
              <div class="quest-badges">
                {{#if difficulty}}
                  <span class="quest-difficulty-badge" style="color: {{difficultyColor}}; border-color: {{difficultyColor}};">{{difficulty}}</span>
                {{/if}}
                <span class="quest-status-badge status-{{lowercase status}}">{{status}}</span>
              </div>
            </div>
            
            <div class="quest-meta-row">
              {{#if commissionedFaction}}
                <span class="quest-commissioned" title="Commissioned Faction"><i class="fas fa-shield-alt"></i> Commissioned by: <strong>{{commissionedFaction}}</strong></span>
              {{/if}}
              {{#if giver}}
                <span class="quest-giver" title="Quest Giver"><i class="fas fa-user-circle"></i> {{giver}}</span>
              {{/if}}
              {{#if assignedNames}}
                <span class="quest-assigned" title="Assigned Party Members"><i class="fas fa-users"></i> {{assignedNames}}</span>
              {{else}}
                <span class="quest-assigned party" title="Whole Party Quest"><i class="fas fa-users"></i> Whole Party</span>
              {{/if}}
              {{#if tasks.length}}
                <span class="quest-task-count" title="Objective Completion"><i class="fas fa-tasks"></i> {{completedTasks}}/{{totalTasks}} Objectives ({{taskProgress}}%)</span>
              {{/if}}
            </div>

            {{#if tasks.length}}
              <div class="quest-mini-progress">
                <div class="quest-mini-progress-fill" style="width: {{taskProgress}}%;"></div>
              </div>
            {{/if}}
          </div>

          <div class="quest-quick-actions">
            {{#if @root.perms.quests}}
              <i class="fas fa-thumbtack quest-pin-btn {{#if isPrimary}}pinned{{/if}}" data-quest-id="{{id}}" title="{{#if isPrimary}}Unpin Primary Objective{{else}}Pin as Primary Objective{{/if}}"></i>
            {{/if}}
            <i class="fas fa-chevron-down quest-expand-icon {{#if isExpanded}}expanded{{/if}}"></i>
          </div>
        </div>

        <!-- Quest Collapsible Details Body -->
        <div class="quest-card-body {{#if isExpanded}}show{{/if}}">
          {{#if description}}
            <div class="quest-description-block">
              {{{description}}}
            </div>
          {{/if}}

          <!-- Tasks / Objectives List -->
          {{#if tasks.length}}
            <div class="quest-tasks-section">
              <div class="quest-section-label"><i class="fas fa-tasks"></i> Objectives</div>
              <div class="quest-tasks-list">
                {{#each tasks}}
                  <div class="quest-task-item {{#if completed}}completed{{/if}} {{#if optional}}optional{{/if}}" data-quest-id="{{../id}}" data-task-id="{{id}}">
                    <input type="checkbox" class="quest-task-checkbox" data-quest-id="{{../id}}" data-task-id="{{id}}" {{#if completed}}checked{{/if}} {{#unless @root.perms.quests}}disabled{{/unless}}>
                    <span class="quest-task-text">{{text}}</span>
                    {{#if optional}}<span class="quest-task-optional">(Optional)</span>{{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
          {{/if}}

          <!-- Rewards Section -->
          {{#if (or rewards.xp rewards.currency rewards.text)}}
            <div class="quest-rewards-section">
              <div class="quest-section-label"><i class="fas fa-gift"></i> Rewards</div>
              <div class="quest-rewards-pills">
                {{#if rewards.xp}}
                  <span class="reward-pill xp"><i class="fas fa-star"></i> {{rewards.xp}} XP</span>
                {{/if}}
                {{#if rewards.currency}}
                  <span class="reward-pill currency"><i class="fas fa-coins"></i> {{rewards.currency}}</span>
                {{/if}}
                {{#if rewards.text}}
                  <span class="reward-pill item"><i class="fas fa-box-open"></i> {{rewards.text}}</span>
                {{/if}}
              </div>
            </div>
          {{/if}}

          <!-- GM Secret Notes -->
          {{#if (and @root.perms.quests gmNotes)}}
            <div class="quest-gm-notes-section">
              <div class="quest-section-label"><i class="fas fa-user-secret"></i> GM Secret Notes</div>
              <div class="quest-gm-notes-content">{{gmNotes}}</div>
            </div>
          {{/if}}

          <!-- Quest Actions Footer -->
          <div class="quest-card-footer">
            <button type="button" class="share-quest-chat" data-quest-id="{{id}}" title="Share to Chat"><i class="fas fa-comment-alt"></i> Share</button>
            {{#if @root.perms.quests}}
              {{#if (ne status 'Completed')}}
                <button type="button" class="complete-quest" data-quest-id="{{id}}"><i class="fas fa-check"></i> Complete</button>
              {{/if}}
              {{#if (ne status 'Failed')}}
                <button type="button" class="fail-quest" data-quest-id="{{id}}"><i class="fas fa-times"></i> Fail</button>
              {{/if}}
              {{#if (or (eq status 'Completed') (eq status 'Failed'))}}
                <button type="button" class="reopen-quest" data-quest-id="{{id}}"><i class="fas fa-redo"></i> Reopen</button>
              {{/if}}
              <button type="button" class="edit-quest" data-quest-id="{{id}}"><i class="fas fa-edit"></i> Edit</button>
            {{/if}}
          </div>
        </div>
      </div>
    {{else}}
      <div class="empty-state">
        <i class="fas fa-scroll"></i>
        {{#if questSearch}}
          <div class="empty-title">No quests found matching "{{questSearch}}"</div>
          <div class="empty-subtitle">Try searching with different keywords or reset your filters.</div>
        {{else if hasActiveFilters}}
          <div class="empty-title">No quests match your selected filters</div>
          <div class="empty-subtitle">Try adjusting your faction, giver, or difficulty filter settings.</div>
          <button type="button" class="reset-quest-filters" style="margin-top: 8px;"><i class="fas fa-undo"></i> Reset Filters</button>
        {{else}}
          <div class="empty-title">No {{questFilter}} quests</div>
          <div class="empty-subtitle">There are currently no quests in this category.</div>
        {{/if}}
      </div>
    {{/each}}
  </div>
</div>
