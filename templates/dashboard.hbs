{{#if showDashboard}}
  {{!-- GM Dashboard --}}
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-label"><i class="fas fa-scroll"></i> Active Quests</div>
      <div class="stat-value">{{stats.activeQuests}}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label"><i class="fas fa-envelope"></i> Unread Mail</div>
      <div class="stat-value">{{stats.unreadMail}}</div>
    </div>
    <div class="stat-card">
      <div class="stat-label"><i class="fas fa-medal"></i> Badges Earned</div>
      <div class="stat-value">{{stats.earnedBadges}}</div>
    </div>
  </div>

  <div class="section-header">
    <h2 class="section-title">Player Overview</h2>
  </div>

  {{#if players.length}}
    <div class="player-grid">
      {{#each players}}
        <div class="player-card" data-actor-id="{{id}}">
          <div class="player-avatar">
            <img src="{{img}}" alt="{{name}}" class="player-img">
          </div>
          <div class="player-info">
            <div class="player-name">{{name}}</div>
            <div class="player-user">{{userName}}</div>
            <div class="player-stats">
              <span title="Factions"><i class="fas fa-shield-alt"></i> {{factionsCount}}</span>
              <span title="Badges"><i class="fas fa-medal"></i> {{badgesCount}}</span>
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div class="empty-state">
      <i class="fas fa-users"></i>
      <p>No players connected</p>
    </div>
  {{/if}}
{{/if}}

{{#if showProfile}}
  {{!-- Player Profile --}}
  {{#if profile}}
    {{#if isGM}}
      <button class="back-btn"><i class="fas fa-arrow-left"></i> Back to Dashboard</button>
    {{/if}}

    <div class="profile-header-card">
      <div class="profile-avatar-frame">
        <img src="{{profile.img}}" alt="{{profile.name}}" class="profile-avatar">
      </div>
      <div>
        <div class="profile-name">{{profile.name}}</div>
        <div class="profile-subtitle">Character Profile</div>
      </div>
    </div>

    <div class="profile-grid">
      <div>
        <h3 class="section-title">Factions</h3>
        {{#if profile.factions.length}}
          {{#each profile.factions}}
            <div class="mini-card faction-profile-card">
              <div class="faction-profile-icon">
                {{#if isImage}}<img src="{{image}}" alt="{{name}}">{{else}}{{image}}{{/if}}
              </div>
              <div style="flex: 1; min-width: 0;">
                <div class="mini-title">{{name}}</div>
                <div class="mini-sub">{{rank}}</div>
                {{#if showProgress}}
                  <div class="faction-progress-wrapper" style="margin-top: 4px;">
                    <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--theme-dim); margin-bottom: 2px;">
                      <span>{{xp}} XP</span>
                      <span>Next: {{nextRankName}} ({{nextRankXP}} XP)</span>
                    </div>
                    <div style="height: 4px; background: rgba(0,0,0,0.2); border-radius: 2px; overflow: hidden;">
                      <div style="height: 100%; width: {{progress}}%; background: var(--theme-accent); border-radius: 2px;"></div>
                    </div>
                  </div>
                {{/if}}
              </div>
            </div>
          {{/each}}
        {{else}}
          <p class="empty-text">No faction memberships</p>
        {{/if}}
      </div>

      <div>
        <h3 class="section-title">Badges</h3>
        {{#if profile.badges.length}}
          {{#each profile.badges}}
            <div class="mini-card badge-profile-card">
              <div class="badge-profile-icon">
                {{#if isImage}}<img src="{{icon}}" alt="{{name}}">{{else}}{{icon}}{{/if}}
              </div>
              <div class="badge-profile-text">
                <div class="mini-title">{{name}}</div>
                <div class="mini-sub">{{description}}</div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <p class="empty-text">No badges earned</p>
        {{/if}}
      </div>

      <div>
        <h3 class="section-title">Active Quests</h3>
        {{#if profile.quests.length}}
          {{#each profile.quests}}
            <div class="mini-card profile-quest-link" data-quest-id="{{id}}" style="cursor: pointer;" title="Click to view quest in Quest Journal">
              {{#if image}}
                <div class="mini-icon" style="flex-shrink: 0; width: 36px; height: 36px; min-width: 36px; border-radius: 3px; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                  <img src="{{image}}" style="width: 100%; height: 100%; object-fit: cover; border: none;">
                </div>
              {{/if}}
              <div style="flex: 1; min-width: 0;">
                <div class="mini-title">{{#if isPrimary}}⭐ {{/if}}{{title}}</div>
                <div class="mini-sub">
                  <span style="color: {{difficultyColor}};">{{difficulty}}</span> • {{status}}
                  {{#if commissionedFaction}} • {{commissionedFaction}}{{else if giver}} • {{giver}}{{/if}}
                  {{#if totalTasks}} ({{completedTasks}}/{{totalTasks}}){{/if}}
                </div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <p class="empty-text">No active quests</p>
        {{/if}}
      </div>

      <div>
        <h3 class="section-title">Messages</h3>
        {{#if profile.messages.length}}
          {{#each profile.messages}}
            <div class="mini-card message-profile-card">
              <div style="flex: 1; min-width: 0;">
                <div class="mini-title">{{subject}}</div>
                <div class="mini-sub">From {{from}}</div>
              </div>
            </div>
          {{/each}}
        {{else}}
          <p class="empty-text">No messages</p>
        {{/if}}
      </div>
    </div>
  {{/if}}
{{/if}}
